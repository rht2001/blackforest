  "codex_integration_plan": [
    {
      "step": 1,
      "task": "Preserve existing Blackforest read-only twin/bridge pipeline and avoid changing Modbus command behavior."
    },
    {
      "step": 2,
      "task": "Add profile selector for dex_tactile_left and rh56_tactile_toolkit_left, each using its OWN link meshes, joint origins/axes, parent hierarchy and mimic relationships."
    },
    {
      "step": 3,
      "task": "Use 6 live ANGLE_ACT values read once from existing polling loop; calibrate and independently enable second profile mapping; never double-poll the hand."
    },
    {
      "step": 4,
      "task": "Render open, half-closed and closed static poses for each profile; visually verify the six driven motions and thumb opposition."
    },
    {
      "step": 5,
      "task": "Add adjustment settings per profile: root rigid transform, direction/sign, actuator range, zero offsets, each driving joint endpoint and mimic parameters. Save to a DIFFERENT overrides file, never edit source reference."
    },
    {
      "step": 6,
      "task": "Overlay sensors from Toolkit fixed sensor joints and evaluate contact location alignment with physical hand; do not confuse sensor mount with individual taxel centres."
    },
    {
      "step": 7,
      "task": "Record reference poses and measured fingertip/joint positions; compute spatial error after alignment, select best validated parameters rather than averaging numerical joint coordinates between frames."
    },
    {
      "step": 8,
      "task": "Only after validation consider one hybrid model: transform validated mechanical parameters into a chosen canonical link-frame convention. Explicitly document source of each substituted parameter."
    }
  ],

  "kinematics_convention": {
    "frame": "origin_xyz and origin_rpy are parent-to-child zero-pose URDF joint transforms, NOT global xyz",
    "rpy_rotation_order": "Rz(yaw) @ Ry(pitch) @ Rx(roll)",
    "joint_motion": "T_parent_child(q) = Translation(origin_xyz) @ RPY(origin_rpy) @ Rot(axis_xyz, q)",
    "fixed_joint": "T_parent_child = origin transform; no rotation axis",
    "mimic_joint": "q_dependent = multiplier * q_driver + offset_rad (unless explicit different source relation)",
    "rendering": "Recursively transform each visual mesh using its own parent link frame. STL alone contains no joint definition.",
    "comparison": "Compare same physical landmark locations after full FK + mesh frame registration, never per-axis raw origin XYZ across profiles."
  },
